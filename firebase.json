{
  "hosting": [
    {
      "target": "standard",
      "public": ".firebase/standard-site",
      "ignore": ["firebase.json", "**/.*", "**/node_modules/**"],
      "cleanUrls": true,
      "trailingSlash": false,
      "headers": [
        {
          "source": "**/*.schema.json",
          "headers": [
            { "key": "Content-Type", "value": "application/schema+json; charset=utf-8" },
            { "key": "Access-Control-Allow-Origin", "value": "*" },
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        },
        {
          "source": "**/*.@(json|md)",
          "headers": [
            { "key": "Access-Control-Allow-Origin", "value": "*" },
            { "key": "Cache-Control", "value": "public, max-age=3600" }
          ]
        },
        {
          "source": "**/*.@(html|css|js)",
          "headers": [
            { "key": "Cache-Control", "value": "public, max-age=600" }
          ]
        }
      ]
    }
  ]
}
